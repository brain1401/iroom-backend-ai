# 프로덕션용 멀티스테이지 Dockerfile
# 한국어 답안지 OCR 백엔드 서비스

# ==================================================
# Stage 1: 빌드 환경 (uv 기반 의존성 설치)
# ==================================================
FROM python:3.13-slim as builder

# 환경 변수
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV UV_CACHE_DIR=/opt/uv-cache

# 시스템 의존성 설치
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# uv 설치 (고속 Python 패키지 관리자)
RUN pip install uv

# 작업 디렉토리 설정
WORKDIR /app

# 프로젝트 의존성 파일 복사
COPY pyproject.toml uv.lock ./

# 의존성 설치 (캐시 최적화)
RUN --mount=type=cache,target=/opt/uv-cache \
    uv sync --frozen --no-dev

# ==================================================
# Stage 2: 프로덕션 런타임 환경
# ==================================================
FROM python:3.13-slim as production

# 메타데이터
LABEL maintainer="iroom-backend-team"
LABEL description="Korean Answer Sheet OCR API - Production"
LABEL version="2.0.0"

# 환경 변수 설정
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH="/app"
ENV ENVIRONMENT=production

# 런타임 의존성 설치 (최소한만)
RUN apt-get update && apt-get install -y \
    libpillow-dev \
    libjpeg62-turbo-dev \
    zlib1g-dev \
    libfreetype6-dev \
    liblcms2-dev \
    libwebp-dev \
    tcl8.6-dev \
    tk8.6-dev \
    python3-tk \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 비root 사용자 생성 (보안)
RUN groupadd -r appuser && useradd -r -g appuser appuser

# 작업 디렉토리 설정
WORKDIR /app

# 빌드 스테이지에서 가상환경 복사
COPY --from=builder /app/.venv /app/.venv

# PATH에 가상환경 추가
ENV PATH="/app/.venv/bin:$PATH"

# 애플리케이션 코드 복사
COPY --chown=appuser:appuser app/ ./app/
COPY --chown=appuser:appuser pyproject.toml ./

# 로그 디렉토리 생성
RUN mkdir -p /app/logs && chown -R appuser:appuser /app/logs

# 임시 파일 디렉토리 생성
RUN mkdir -p /app/tmp && chown -R appuser:appuser /app/tmp

# 사용자 전환
USER appuser

# 헬스체크 설정
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health/api', timeout=5)"

# 포트 노출
EXPOSE 8000

# 실행 명령어
CMD ["python", "-m", "uvicorn", "app.server:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "4", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--log-level", "info", \
     "--access-log", \
     "--no-server-header"]

# ==================================================
# Stage 3: 개발 환경 (선택적)
# ==================================================
FROM python:3.13-slim as development

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH="/app"
ENV ENVIRONMENT=development

# 개발용 시스템 의존성 (추가 도구 포함)
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    vim \
    htop \
    libpillow-dev \
    libjpeg62-turbo-dev \
    zlib1g-dev \
    libfreetype6-dev \
    liblcms2-dev \
    libwebp-dev \
    && rm -rf /var/lib/apt/lists/*

# uv 설치
RUN pip install uv

WORKDIR /app

# 개발용 의존성 포함 설치
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen

# 개발용 PATH 설정
ENV PATH="/app/.venv/bin:$PATH"

# 개발 서버 실행
CMD ["python", "-m", "uvicorn", "app.server:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--reload", \
     "--log-level", "debug"]