# Gemini AI Backend Configuration
# Copy this file to .env and configure your settings

# ======================
# Google Cloud Platform Configuration (Vertex AI)
# ======================
# GCP 프로젝트 설정 (gcloud CLI로 자동 인증)
GCP_PROJECT_ID=question-recognition-395816
GCP_LOCATION=us-central1  # 또는 asia-northeast3
# Vertex AI Gemini 모델 설정
GEMINI_MODEL=gemini-2.5-pro
GEMINI_MAX_TOKENS=32000
GEMINI_TEMPERATURE=0.7

# ======================
# Server Configuration
# ======================
APP_NAME=Gemini AI Backend
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ======================
# Rate Limiting (Gemini 2.5 Pro Limits)
# ======================
# Free tier: 15 RPM, 1M tokens/day
# Paid tier: 60 RPM, 10M tokens/day
RATE_LIMIT_REQUESTS_PER_MINUTE=15
RATE_LIMIT_TOKENS_PER_DAY=1000000
RATE_LIMIT_ENABLED=true

# ======================
# Redis Configuration (Optional)
# ======================
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# ======================
# CORS Configuration
# ======================
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true

# ======================
# Authentication (Optional)
# ======================
API_KEY_HEADER=x-api-key
REQUIRE_API_KEY=false
VALID_API_KEYS=[]

# ======================
# Logging Configuration
# ======================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ======================
# Health Checks
# ======================
HEALTH_CHECK_ENABLED=true

# ======================
# Database Configuration
# ======================
# MySQL/MariaDB connection URL format:
# mysql+pymysql://username:password@host:port/database
DATABASE_URL=mysql+pymysql://campus_25SW_FS_p3_4:smhrd4@project-db-campus.smhrd.com:3307/campus_25SW_FS_p3_4
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ENABLED=true